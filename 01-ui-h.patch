 constexpr uint16_t menu_icon_width = 24;
 constexpr uint16_t menu_icon_height = 24;
-typedef uint16_t const menu_icon_t[menu_icon_width * menu_icon_height]; // 24x24px icon (576*2 bytes)
+
+// Packed 1bpp icon: separate color and mask (transparency) bitplanes,
+// row-major, MSB-first, stride=(width+7)/8 bytes/row per plane - matches
+// every other 1bpp bit layout in the firmware. Replaces the old
+// 576*uint16_t RGB565-with-magic-transparent-color format: real alpha data
+// drives real transparency now, instead of sacrificing one color as a
+// transparency key. Generated by tools/image2code.py --mono.
+struct MonoIconAsset {
+    uint16_t width;
+    uint16_t height;
+    const uint8_t* color;
+    const uint8_t* mask;
+};
+typedef MonoIconAsset menu_icon_t;
 
